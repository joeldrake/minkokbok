{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "minkokbok",
  "compatibility_date": "2026-09-25",
  // Hanterar /api/*. Allt annat går direkt till de statiska filerna.
  "main": "worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    // Låt Vue Router hantera alla sökvägar, t.ex. /anna
    "not_found_handling": "single-page-application"
  },
  "vars": {
    "DEXIE_DB_URL": "https://zh1ojo18g.dexie.cloud"
  }
  // Hemligheter (lokalt i .dev.vars, i produktion med `wrangler secret put`):
  // DEXIE_CLIENT_ID, DEXIE_CLIENT_SECRET
}
